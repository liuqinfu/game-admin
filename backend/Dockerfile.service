FROM golang:1.25 AS builder

ARG SERVICE_NAME
WORKDIR /app/backend

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend ./
RUN test -n "$SERVICE_NAME"
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/service ./cmd/${SERVICE_NAME}

FROM debian:bookworm-slim

ARG SERVICE_NAME
WORKDIR /srv/app

RUN useradd -r -u 10001 appuser
COPY --from=builder /out/service /srv/app/service

USER appuser
EXPOSE 8080
ENTRYPOINT ["/srv/app/service"]
